; Create lists
(define nums (list 1 2 3 4 5))
(define fruits (list "apple" "banana" "cherry"))

; Access
(print "first: " (car nums))
(print "rest: " (cdr nums))

; Build
(print "cons: " (cons 0 nums))
(print "empty cons: " (cons 1 nil))

; Properties
(print "length: " (length nums))
(print "length empty: " (length (list)))

; Append
(print "append: " (append nums (list 6 7 8)))

; List from scratch
(define l (cons 1 (cons 2 (cons 3 (cons 4 nil)))))
(print "built: " l)

; Nested lists
(define matrix (list (list 1 2) (list 3 4) (list 5 6)))
(print "matrix: " matrix)
(print "first row: " (car matrix))
(print "first of first: " (car (car matrix)))
